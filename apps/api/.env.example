# Local SQLite (default if unset): apps/api/data/jose.sqlite
# Later, point this at Turso:
# JOSE_DATABASE_URL=libsql://your-db.turso.io
# JOSE_DATABASE_AUTH_TOKEN=...
JOSE_DATABASE_URL=file:./data/jose.sqlite
PORT=3001

# Signed Jose sessions (required before admin bootstrap or teacher API access)
# JOSE_SESSION_SECRET=generate-a-long-random-secret

# One-time first-admin bootstrap (remove TOKEN after the first admin exists)
# JOSE_ADMIN_BOOTSTRAP_EMAIL=you@apc.edu.ph
# JOSE_ADMIN_BOOTSTRAP_TOKEN=one-time-operational-secret

# Local-only session minting for an existing account (never enable in production)
# JOSE_AUTH_DEV_LOGIN=1

# Optional: server-side web fetches to teach APIs during local SSR
# JOSE_WEB_SESSION_TOKEN=
