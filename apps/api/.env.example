# Jose API environment

# Database (local SQLite by default)
# JOSE_DATABASE_URL=file:./data/jose.sqlite
# JOSE_DATABASE_AUTH_TOKEN=

# Explicit demo mode: unauthenticated requests use the shared demo-student learner.
# Keep true for local playgrounds; set false before real school accounts.
JOSE_DEMO_MODE=true

# Dev-only login that mints HttpOnly sessions without Microsoft.
# Disable in any shared/staging/production environment.
JOSE_DEV_LOGIN=true

# Cookie policy for jose_session
JOSE_COOKIE_SECURE=false
JOSE_COOKIE_SAMESITE=lax

# Comma-separated browser origins allowed with credentials
JOSE_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Microsoft Entra (optional — leave unset to keep Microsoft login disabled)
# All three required together; partial config fails boot.
# JOSE_MS_CLIENT_ID=
# JOSE_MS_CLIENT_SECRET=
# JOSE_MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# JOSE_MS_TENANT=common
