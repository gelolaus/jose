# Legacy API-only reference. For local development, copy the repository-root
# `.env.example` to the root `.env`; both apps read that single file.
# Local SQLite (default if unset): apps/api/data/jose.sqlite
# Later, point this at Turso (token is server-only — never NEXT_PUBLIC_*):
# JOSE_DATABASE_URL=libsql://your-db.turso.io
# JOSE_DATABASE_AUTH_TOKEN=...
JOSE_DATABASE_URL=file:./data/jose.sqlite
PORT=3001

# Comma-separated CORS origins. Production can also use JOSE_WEB_ORIGIN alone.
# JOSE_ALLOWED_ORIGINS=https://jose.example.edu

# Reverse-proxy hops Express may trust when computing req.ip for rate limits.
# Leave unset/false unless the API sits behind a known proxy. Never read
# X-Forwarded-For in application code.
# JOSE_TRUST_PROXY=1

# JSON body ceiling (bytes). Default 262144 safely carries the documented
# JMM maximum (200_000 UTF-8 bytes) plus JSON envelope/escaping overhead.
# JOSE_MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# Auth mode: disabled | mock | microsoft
# `mock` is for local development and automated tests only. Production refuses
# to boot with it (see docs/auth/microsoft-entra-setup.md).
# ---------------------------------------------------------------------------
JOSE_AUTH_MODE=mock
JOSE_SESSION_SECRET=dev-only-change-me-to-a-long-random-secret
JOSE_WEB_ORIGIN=http://localhost:3000
JOSE_API_PUBLIC_URL=http://localhost:3001
# Defaults to true in production. Leave unset locally.
# JOSE_COOKIE_SECURE=true

# Lets anonymous visitors browse published modules as the shared demo learner.
# Playing, completing, and saving progress still require a real signed-in
# student. DEVELOPMENT ONLY — production refuses to boot with it.
JOSE_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Required when JOSE_AUTH_MODE=microsoft — see docs/auth/microsoft-entra-setup.md
# Point the redirect URI at the web origin's /api proxy so the session cookie
# stays first-party.
# ---------------------------------------------------------------------------
# JOSE_MICROSOFT_CLIENT_ID=
# JOSE_MICROSOFT_CLIENT_SECRET=
# JOSE_MICROSOFT_TENANT=common
# JOSE_MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Mailbox OTP delivery. `memory` keeps codes in server memory and is refused in
# production when JOSE_AUTH_MODE=microsoft.
# JOSE_MAIL_TRANSPORT=memory

# Session / mailbox tuning (all optional)
# JOSE_SESSION_TTL_SECONDS=1209600
# JOSE_PENDING_TTL_SECONDS=1800
# JOSE_MAILBOX_CODE_TTL_SECONDS=900
# JOSE_MAILBOX_MAX_ATTEMPTS=5
# JOSE_MAILBOX_RESEND_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# One-time first-admin bootstrap. There are NO seeded admin accounts.
# Set both, POST /auth/admin/bootstrap once, then DELETE the token from the
# environment. The email must be an APC mailbox.
# ---------------------------------------------------------------------------
# JOSE_ADMIN_BOOTSTRAP_EMAIL=dean@apc.edu.ph
# JOSE_ADMIN_BOOTSTRAP_TOKEN=

# ---------------------------------------------------------------------------
# One-time pinned promotion for arlaus@student.apc.edu.ph (persisted admin).
# The account must already exist from normal sign-in. Run once, then DELETE
# the token from the environment:
#   JOSE_PROMOTE_ARLAUS_TOKEN=<long-random> npm run db:promote-arlaus --workspace=@jose/api
# ---------------------------------------------------------------------------
# JOSE_PROMOTE_ARLAUS_TOKEN=

# ---------------------------------------------------------------------------
# Never set these in production. Startup fails with exit code 1 if it sees them
# alongside NODE_ENV=production or JOSE_ENV=production:
#   JOSE_AUTH_MODE=mock
#   JOSE_AUTH_MODE=disabled
#   JOSE_DEMO_MODE=true
#   JOSE_MAIL_TRANSPORT=memory (when JOSE_AUTH_MODE=microsoft)
# Local dev login shortcuts (/auth/dev/*, LocalDevPanel) were deleted in
# Batch 1 and must not be reintroduced.
# ---------------------------------------------------------------------------
