{
  "name": "@jose/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "db:migrate": "ts-node --transpile-only src/db/migrate-cli.ts",
    "db:backup": "ts-node --transpile-only src/db/backup-cli.ts",
    "db:restore": "ts-node --transpile-only src/db/restore-cli.ts",
    "db:seed": "ts-node --transpile-only src/db/seed-cli.ts",
    "test": "jest --config ./jest.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jose/shared": "*",
    "@libsql/client": "^0.17.4",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "openid-client": "^6.8.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
