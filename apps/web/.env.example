# Public browser API base. Prefer unset so the app uses same-origin `/api` (cookie-ready).
# NEXT_PUBLIC_API_URL=https://api.jose.example.edu

# Server-only rewrite target for Next.js `/api/*` proxy (SSR + rewrite). Not a secret.
JOSE_INTERNAL_API_URL=http://127.0.0.1:3001

# NEVER set NEXT_PUBLIC_* for database tokens, OAuth client secrets, or session secrets.
