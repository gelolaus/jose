{
  "name": "jose",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@jose/web",
    "dev:api": "turbo run dev --filter=@jose/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "npm run db:migrate --workspace=@jose/api",
    "db:backup": "npm run db:backup --workspace=@jose/api",
    "db:restore": "npm run db:restore --workspace=@jose/api",
    "typecheck": "turbo run lint",
    "ci": "npm run build --workspace=@jose/shared && turbo run lint test build",
    "audit:deps": "npm audit --omit=dev",
    "db:seed": "npm run db:seed --workspace=@jose/api"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.8.3"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  }
}
