# Jose local development configuration. Copy this file to `.env` at the
# repository root. Both the API and web app load this one file.
# API commands run from apps/api, so this remains apps/api/data/jose.sqlite.
JOSE_DATABASE_URL=file:./data/jose.sqlite
PORT=3001

JOSE_AUTH_MODE=mock
JOSE_SESSION_SECRET=dev-only-change-me-to-a-long-random-secret
JOSE_WEB_ORIGIN=http://localhost:3000
JOSE_API_PUBLIC_URL=http://localhost:3001
JOSE_DEMO_MODE=true

# Server-only Next.js rewrite target. Keep NEXT_PUBLIC_API_URL unset.
JOSE_INTERNAL_API_URL=http://127.0.0.1:3001
