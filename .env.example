# Jose local development configuration. Copy this file to `.env` at the
# repository root. Both the API and web app load this one file.
# Turso database. Use the same root `.env` on this machine; never commit the
# real URL or token.
JOSE_DATABASE_URL=libsql://your-database.turso.io
JOSE_DATABASE_AUTH_TOKEN=replace-with-your-turso-auth-token
PORT=3001

JOSE_AUTH_MODE=mock
JOSE_SESSION_SECRET=dev-only-change-me-to-a-long-random-secret
JOSE_WEB_ORIGIN=http://localhost:3000
JOSE_ALLOWED_ORIGINS=http://localhost:3000
JOSE_API_PUBLIC_URL=http://localhost:3001
JOSE_DEMO_MODE=true

# Local API requests do not pass through Caddy/Nginx, so leave this unset.
# JOSE_TRUST_PROXY=1

# Ordinary API request limit. JMM import routes receive their own 512KB limit.
# JOSE_MAX_BODY_BYTES=262144

# To test real Microsoft sign-in locally, change JOSE_AUTH_MODE above to
# `microsoft`, disable demo mode, and fill these values. Keep the callback
# registered in Microsoft Entra exactly as written below.
# JOSE_DEMO_MODE=false
# JOSE_MICROSOFT_CLIENT_ID=
# JOSE_MICROSOFT_CLIENT_SECRET=
# JOSE_MICROSOFT_TENANT=common
# JOSE_MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
# JOSE_COOKIE_SECURE=false

# Server-only Next.js rewrite target. Keep NEXT_PUBLIC_API_URL unset.
JOSE_INTERNAL_API_URL=http://127.0.0.1:3001
